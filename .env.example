# Chave da Gemini API (aistudio.google.com/apikey ou Google Cloud Console)
# Precisa ter a Generative Language API habilitada (pra Veo)
GEMINI_API_KEY=

# Chave da Google Cloud Text-to-Speech API
# Pode ser a MESMA chave acima, desde que "Cloud Text-to-Speech API"
# esteja habilitada no mesmo projeto GCP (console.cloud.google.com/apis/library)
GOOGLE_TTS_API_KEY=

# Voz do narrador (pt-BR). Lista completa: cloud.google.com/text-to-speech/docs/voices
TTS_VOICE_NAME=pt-BR-Chirp3-HD-Achernar
TTS_LANGUAGE_CODE=pt-BR
