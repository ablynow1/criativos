# Projeto GCP onde a Vertex AI (Veo) e o Cloud Text-to-Speech vão faturar.
# Usa os créditos normais do Cloud Billing do projeto (não precisa de API key nem prepay separado).
GOOGLE_CLOUD_PROJECT=atelier-usemalta
GOOGLE_CLOUD_LOCATION=us-central1

# Service account (OAuth2) usada pra autenticar TANTO a Vertex AI (Veo) quanto o Cloud TTS.
# Criar em: IAM & Admin > Service Accounts > Create > Keys > Add Key > JSON
# Salvar o arquivo baixado como service-account.json na raiz do projeto (já no .gitignore).
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# Modelo do Veo na Vertex AI (pode mudar conforme disponibilidade/preview).
VEO_MODEL=veo-3.1-generate-001

# Voz do narrador (pt-BR). Lista completa: cloud.google.com/text-to-speech/docs/voices
# Precisa ser Neural2 ou Wavenet — vozes Chirp3-HD não suportam <mark> de SSML,
# o que quebra o timestamp por palavra (legenda fica sem sincronismo).
TTS_VOICE_NAME=pt-BR-Neural2-C
TTS_LANGUAGE_CODE=pt-BR

# --- Freepik/Magnific API (refino de imagem + motores de vídeo alternativos) ---
# Chave de API — DIFERENTE da service account do Google (aquela é só Vertex/Veo/TTS).
# Gere em freepik.com (Dashboard > API) ou magnific.com. Sem ela, refino e motores
# Freepik (Kling/Seedance) não rodam; o Veo continua funcionando normal.
FREEPIK_API_KEY=

# Host + header de auth da API. Default = Magnific. Se a chave for do Freepik "clássico":
#   FREEPIK_API_BASE=https://api.freepik.com/v1/ai
#   FREEPIK_API_KEY_HEADER=x-freepik-api-key
FREEPIK_API_BASE=https://api.magnific.com/v1/ai
FREEPIK_API_KEY_HEADER=x-magnific-api-key

# Motor de vídeo padrão: "veo" (Vertex, fatura no Cloud) ou "freepik:<model>"
# (ex "freepik:kling-v2", "freepik:seedance-pro-1080p"; fatura na Freepik).
# Dá pra sobrescrever por run com --motor, ou por cena com "motor" no JSON.
VIDEO_ENGINE=veo

# Refino da imagem antes do vídeo (upscaler de precisão da Magnific, fiel à identidade).
# Deixa a imagem do Nano Banana (768x1344, soft) nítida e ~2x maior antes do vídeo.
# true liga por padrão; sobrescreve por run com --refino / --no-refino.
REFINE_IMAGES=false
# Ajustes finos do refino (opcionais):
REFINE_SCALE_FACTOR=2
REFINE_SHARPEN=45
REFINE_ULTRA_DETAIL=45
REFINE_SMART_GRAIN=0
REFINE_FLAVOR=photo
